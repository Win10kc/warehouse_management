<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/wh_bg">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/wh_surface"
        android:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CHỌN SẢN PHẨM"
                android:textColor="@color/wh_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"/>

        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <!-- Amber underline under toolbar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/wh_amber"/>

    <!-- Search box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@color/wh_surface">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Tìm theo tên hoặc SKU..."
            android:inputType="text"
            android:background="@drawable/bg_input_field"
            android:textColor="@color/wh_text_primary"
            android:textColorHint="@color/wh_text_muted"
            android:textSize="14sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"/>

    </LinearLayout>

    <!-- Thin border below search area -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/wh_border"/>

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:indeterminateTint="@color/wh_amber"
        android:layout_marginTop="24dp"
        android:visibility="gone"/>

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="40dp"
        android:gravity="center"
        android:textSize="14sp"
        android:textColor="@color/wh_text_muted"
        android:text="Không tìm thấy sản phẩm"
        android:visibility="gone"/>

    <!-- Results list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false"/>

</LinearLayout>