<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/wh_bg">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/wh_surface"
        android:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TẠO PHIẾU XUẤT / NHẬP"
                android:textColor="@color/wh_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"/>

        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <!-- Amber underline -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/wh_amber"/>

    <!-- Scrollable form -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Selected product card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/wh_surface"
                app:cardCornerRadius="4dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="40dp"
                        android:background="@color/wh_amber"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:id="@+id/tvProductName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/wh_text_primary"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Section: Loại phiếu -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOẠI PHIẾU"
                android:textSize="10sp"
                android:textColor="@color/wh_amber"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="10dp"/>

            <RadioGroup
                android:id="@+id/rgType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <RadioButton
                    android:id="@+id/rbImport"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="NHẬP KHO"
                    android:textColor="@color/wh_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:checked="true"
                    android:button="@null"
                    android:gravity="center"
                    android:background="@drawable/bg_transaction_type"
                    android:layout_marginEnd="8dp"/>

                <RadioButton
                    android:id="@+id/rbExport"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="XUẤT KHO"
                    android:textColor="@color/wh_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:button="@null"
                    android:gravity="center"
                    android:background="@drawable/bg_transaction_type"/>

            </RadioGroup>

            <!-- Section: Location cascade -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VỊ TRÍ LƯU KHO"
                android:textSize="10sp"
                android:textColor="@color/wh_amber"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="12dp"/>

            <!-- Warehouse -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kho"
                android:textSize="11sp"
                android:textColor="@color/wh_text_secondary"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/spinnerWarehouse"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:layout_marginBottom="10dp"/>

            <!-- Zone -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khu vực (Zone)"
                android:textSize="11sp"
                android:textColor="@color/wh_text_secondary"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/spinnerZone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:layout_marginBottom="10dp"/>

            <!-- Rack -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kệ (Rack)"
                android:textSize="11sp"
                android:textColor="@color/wh_text_secondary"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/spinnerRack"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:layout_marginBottom="10dp"/>

            <!-- Bin -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ô (Bin)"
                android:textSize="11sp"
                android:textColor="@color/wh_text_secondary"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/spinnerBin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:layout_marginBottom="20dp"/>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/wh_border"
                android:layout_marginBottom="20dp"/>

            <!-- Section: Quantity + Note -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHI TIẾT PHIẾU"
                android:textSize="10sp"
                android:textColor="@color/wh_amber"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="12dp"/>

            <!-- Quantity -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Số lượng"
                android:textSize="11sp"
                android:textColor="@color/wh_text_secondary"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etQuantity"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:inputType="number"
                android:hint="0"
                android:background="@drawable/bg_input_field"
                android:textColor="@color/wh_text_primary"
                android:textColorHint="@color/wh_text_muted"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="14dp"/>

            <!-- Note -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ghi chú (tuỳ chọn)"
                android:textSize="11sp"
                android:textColor="@color/wh_text_secondary"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/etNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ghi chú..."
                android:inputType="textMultiLine"
                android:minLines="2"
                android:background="@drawable/bg_input_field"
                android:textColor="@color/wh_text_primary"
                android:textColorHint="@color/wh_text_muted"
                android:textSize="14sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_marginBottom="16dp"/>

            <!-- Error -->
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/wh_red"
                android:textSize="13sp"
                android:visibility="gone"
                android:layout_marginBottom="8dp"
                android:text=""/>

            <!-- Progress -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:indeterminateTint="@color/wh_amber"
                android:visibility="gone"
                android:layout_marginBottom="8dp"/>

            <!-- Submit -->
            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="TẠO PHIẾU"
                android:textColor="@color/wh_amber_on"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textSize="14sp"
                android:background="@drawable/bg_main_button"
                android:stateListAnimator="@null"
                android:layout_marginBottom="24dp"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>