<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/wh_surface"
    android:padding="20dp">

    <!-- Dialog header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <View
            android:layout_width="3dp"
            android:layout_height="20dp"
            android:background="@color/wh_amber"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ĐỀ XUẤT SẢN PHẨM"
            android:textSize="11sp"
            android:textColor="@color/wh_amber"
            android:textStyle="bold"
            android:letterSpacing="0.12"/>

    </LinearLayout>

    <!-- Tên sản phẩm -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tên sản phẩm *"
        android:textSize="11sp"
        android:textColor="@color/wh_text_secondary"
        android:layout_marginBottom="6dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSuggestedName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:textColor="@color/wh_text_primary"
            android:textColorHint="@color/wh_text_muted"
            android:textSize="14sp"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Nhà cung cấp -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nhà cung cấp (không bắt buộc)"
        android:textSize="11sp"
        android:textColor="@color/wh_text_secondary"
        android:layout_marginBottom="6dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSupplierName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="VD: Công ty TNHH ABC"
            android:inputType="textCapSentences"
            android:textColor="@color/wh_text_primary"
            android:textColorHint="@color/wh_text_muted"
            android:textSize="14sp"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Ghi chú -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ghi chú (không bắt buộc)"
        android:textSize="11sp"
        android:textColor="@color/wh_text_secondary"
        android:layout_marginBottom="6dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:lines="2"
            android:textColor="@color/wh_text_primary"
            android:textColorHint="@color/wh_text_muted"
            android:textSize="14sp"/>

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>