<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/activity_pick_list.xml -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- ── Header ─────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E3A5F"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnPickListBack"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="← Quay lại"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_secondary_button"
                android:paddingHorizontal="12dp"/>

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

            <TextView
                android:id="@+id/tvPickListProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 0"
                android:textSize="12sp"
                android:textColor="#93C5FD"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lệnh xuất kho"
            android:textSize="12sp"
            android:textColor="#93C5FD"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/tvPickListCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXP-..."
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFamily="monospace"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/tvPickListStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PROCESSING"
            android:textSize="11sp"
            android:textColor="#34D399"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📦 Đến đúng bin, lấy đủ số lượng, bấm XÁC NHẬN từng dòng."
            android:textSize="12sp"
            android:textColor="#BFDBFE"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"/>
    </LinearLayout>

    <!-- ── Error banner — ĐỂ NGOÀI cả loading lẫn content ──────
         Hiện khi state = Error hoặc SubmitError, ẩn khi state khác.
         Trước đây nằm trong layoutPickListContent (visibility=gone)
         nên không bao giờ hiện khi state=Error.                  -->
    <TextView
        android:id="@+id/tvPickListError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:background="#FEF2F2"
        android:textColor="#DC2626"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        android:visibility="gone"/>

    <!-- ── Loading state ──────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutPickListLoading"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <ProgressBar
            android:id="@+id/progressBarPickList"
            android:layout_width="48dp"
            android:layout_height="48dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đang tải phiếu..."
            android:textColor="#6B7280"
            android:layout_marginTop="12dp"/>
    </LinearLayout>

    <!-- ── Content state ──────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutPickListContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPickList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingVertical="8dp"/>

        <Button
            android:id="@+id/btnPickListSubmit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_margin="12dp"
            android:text="Xác nhận hết để hoàn tất"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_main_button"
            android:enabled="false"
            android:alpha="0.5"/>
    </LinearLayout>

</LinearLayout>