<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.WarehouseApp">

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.main.MainActivity" android:exported="false"/>
        <activity android:name=".ui.scan.ScanActivity" android:exported="false"/>
        <activity android:name=".ui.transaction.TransactionFormActivity"
            android:exported="false"/>

        <activity
            android:name=".ui.mytransactions.MyTransactionsActivity"
            android:label="Phiếu của tôi"
            android:theme="@style/Theme.WarehouseApp"/>

        <activity
            android:name=".ui.transaction.ProductSearchActivity"
            android:label="Chọn sản phẩm"
            android:theme="@style/Theme.WarehouseApp"/>

        <activity
            android:name=".ui.picklist.PickListActivity"
            android:label="Lệnh xuất kho"
            android:theme="@style/Theme.WarehouseApp"/>

        <activity
             android:name=".ui.stockcount.StockCountActivity"
             android:label="Kiểm kê kho"
             android:theme="@style/Theme.WarehouseApp"/>





    </application>
</manifest>